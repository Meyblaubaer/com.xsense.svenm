{
  "id": "com.xsense.svenm",
  "version": "1.1.8",
  "compatibility": ">=12.2.0",
  "sdk": 3,
  "name": {
    "en": "X-Sense",
    "de": "X-Sense"
  },
  "description": {
    "en": "Ultimate home safety. IMPORTANT: Use a dedicated Homey account via X-Sense Family Share!",
    "de": "Ultimative Sicherheit. WICHTIG: Nutzen Sie einen dedizierten Homey-Account über X-Sense Family Share!"
  },
  "category": [
    "security",
    "climate"
  ],
  "tags": {
    "en": [
      "xsense",
      "x-sense",
      "smoke detector",
      "fire alarm",
      "carbon monoxide",
      "CO detector",
      "security",
      "temperature sensor",
      "humidity sensor",
      "hygrometer",
      "water leak detector",
      "flood sensor",
      "door sensor",
      "motion detector",
      "PIR",
      "mailbox",
      "heat detector"
    ],
    "de": [
      "xsense",
      "x-sense",
      "rauchmelder",
      "feueralarm",
      "kohlenmonoxid",
      "CO-melder",
      "sicherheit",
      "temperatursensor",
      "luftfeuchtigkeit",
      "hygrometer",
      "wassersensor",
      "türsensor",
      "bewegungsmelder",
      "briefkasten",
      "hitzemelder"
    ]
  },
  "brandColor": "#FF6B35",
  "images": {
    "large": "assets/images/large.png",
    "small": "assets/images/small.png"
  },
  "author": {
    "name": "Sven-Christian Meyhoefer",
    "email": ""
  },
  "bugs": {
    "url": "https://github.com/Meyblaubaer/com.xsense.svenm/issues"
  },
  "source": "https://github.com/Meyblaubaer/com.xsense.svenm",
  "contributing": {
    "donate": {
      "githubSponsors": {
        "username": "Meyblaubaer"
      }
    }
  },
  "capabilities": {
    "alarm_activate": {
      "type": "boolean",
      "title": {
        "en": "Activated",
        "de": "Aktiviert"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor"
    },
    "alarm_life_end": {
      "type": "boolean",
      "title": {
        "en": "End of Life",
        "de": "Lebensende"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor"
    },
    "alarm_mqtt_connected": {
      "type": "boolean",
      "title": {
        "en": "MQTT Connected",
        "de": "MQTT verbunden"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor"
    },
    "alarm_muted": {
      "type": "boolean",
      "title": {
        "en": "Muted",
        "de": "Stumm"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor"
    },
    "measure_alarm_volume": {
      "type": "number",
      "title": {
        "en": "Alarm Volume",
        "de": "Alarm-Lautstaerke"
      },
      "unit": "%",
      "min": 0,
      "max": 100,
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    },
    "measure_ip_address": {
      "type": "string",
      "title": {
        "en": "IP Address",
        "de": "IP-Adresse"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor"
    },
    "measure_last_seen": {
      "type": "string",
      "title": {
        "en": "Last Seen",
        "de": "Zuletzt gesehen"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor"
    },
    "measure_rf_level": {
      "type": "number",
      "title": {
        "en": "RF Level",
        "de": "RF-Level"
      },
      "min": 0,
      "max": 4,
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    },
    "measure_smoke_status": {
      "type": "string",
      "title": {
        "en": "Smoke Status",
        "de": "Rauchstatus"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "assets/images/measure_smoke_status.svg",
      "insights": true
    },
    "measure_sw_version": {
      "type": "string",
      "title": {
        "en": "Firmware Version",
        "de": "Firmware-Version"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor"
    },
    "measure_voice_volume": {
      "type": "number",
      "title": {
        "en": "Voice Volume",
        "de": "Sprachlautstaerke"
      },
      "unit": "%",
      "min": 0,
      "max": 100,
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    },
    "measure_wifi_rssi": {
      "type": "number",
      "title": {
        "en": "WiFi RSSI",
        "de": "WiFi RSSI"
      },
      "unit": "dBm",
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    },
    "measure_wifi_ssid": {
      "type": "string",
      "title": {
        "en": "WiFi SSID",
        "de": "WiFi SSID"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor"
    },
    "measure_wifi_sw": {
      "type": "string",
      "title": {
        "en": "WiFi Firmware",
        "de": "WiFi-Firmware"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor"
    }
  }
}
